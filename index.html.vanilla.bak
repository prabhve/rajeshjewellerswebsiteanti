  <!-- ========================================================================
       DEALER / SHOP ADMIN MANAGEMENT SUITE (दुकानदार / डीलर पोर्टल MODAL)
       ======================================================================== -->
  <div class="dealer-modal-overlay" id="dealer-modal">
    <div class="dealer-modal-card">
      <div class="dealer-modal-header">
        <div class="dealer-header-title">
          <h3>दुकानदार प्रबंधन पोर्टल (Dealer Showcase Suite)</h3>
          <span class="dealer-badge">Store Admin</span>
        </div>
        <button onclick="closeDealerModal()" style="background: none; border: none; color: #FFF; font-size: 1.6rem; cursor: pointer;">&times;</button>
      </div>

      <div class="dealer-tabs-nav">
        <button class="dealer-tab-btn active" data-pane="dealer-add-tab">
          + Add New Item to Online Store
        </button>
        <button class="dealer-tab-btn" data-pane="dealer-rates-tab">
          ⚙️ Update Live Bullion Rates
        </button>
        <button class="dealer-tab-btn" data-pane="dealer-inventory-tab">
          📋 Current Online Inventory
        </button>
      </div>

      <!-- Tab 1: Add New Product -->
      <div class="dealer-tab-pane active" id="dealer-add-tab">
        <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.5rem;">
          Add any new jewellery piece to your live website showcase. Customers in Mirzapur will immediately see it in your online store with real-time rate calculations!
        </p>

        <form id="add-product-form" onsubmit="handleDealerAddProduct(event)">
          <div class="dealer-form-grid">
            <div class="form-field">
              <label>Ornament English Name</label>
              <input type="text" id="new-item-name" placeholder="e.g. Royal 22K Kundan Choker Necklace" required>
            </div>
            <div class="form-field">
              <label>Hindi Name / हिंदी नाम</label>
              <input type="text" id="new-item-hindi" placeholder="e.g. शाही 22K कुंदन चोकर हार" required>
            </div>

            <div class="form-field">
              <label>Jewellery Category</label>
              <select id="new-item-category" required>
                <option value="bridal">Royal Bridal Sets</option>
                <option value="gold">22K Gold Necklaces</option>
                <option value="bangles">Temple Bangles & Kadas</option>
                <option value="diamond">Solitaire Diamonds</option>
                <option value="everyday">Everyday & Mangalsutra</option>
                <option value="mens">Men's Jewels</option>
                <option value="coins">24K Gold Coins</option>
                <option value="silver">Silver & Pooja Articles</option>
              </select>
            </div>

            <div class="form-field">
              <label>Metal Purity / शुद्धता</label>
              <select id="new-item-purity" required>
                <option value="gold22k">22K BIS 916 Hallmark</option>
                <option value="gold24k">24K Pure 999 Bullion</option>
                <option value="gold18k">18K Diamond Certified Gold</option>
                <option value="silver999">92.5% Pure Sterling Silver</option>
              </select>
            </div>

            <div class="form-field">
              <label>Gross Weight (Grams)</label>
              <input type="number" id="new-item-gross" step="0.01" placeholder="e.g. 48.50" required>
            </div>

            <div class="form-field">
              <label>Net Pure Gold/Silver Weight (Grams)</label>
              <input type="number" id="new-item-net" step="0.01" placeholder="e.g. 45.20" required>
            </div>

            <div class="form-field">
              <label>Making Charges (%)</label>
              <input type="number" id="new-item-making" step="0.5" value="10" placeholder="e.g. 10" required>
            </div>

            <div class="form-field">
              <label>Special Tag / Badge</label>
              <select id="new-item-badge">
                <option value="New Arrival">New Arrival (नया संग्रह)</option>
                <option value="Lagan Special">Lagan Special (विवाह स्पेशल)</option>
                <option value="Bestseller">Bestseller (लोकप्रिय)</option>
                <option value="Exclusive">Exclusive Masterpiece</option>
                <option value="Ready to Ship">Ready to Ship</option>
              </select>
            </div>

            <div class="form-field" style="grid-column: 1 / -1;">
              <label>Select Showcase Photo</label>
              <select id="new-item-image">
                <option value="assets/images/hero_bridal.jpg">Royal Bridal Polki Choker (Hero)</option>
                <option value="assets/images/necklace_collection.jpg">22K Filigree Gold Choker</option>
                <option value="assets/images/antique_bangles.jpg">Lakshmi Temple Kada Pair</option>
                <option value="assets/images/diamond_rings.jpg">Diamond Solitaire & Bands</option>
                <option value="assets/images/earrings_jhumka.jpg">Chandbali Jhumkas & Mangalsutra</option>
                <option value="assets/images/mens_chain_kada.jpg">Men's Lion Kada & Italian Chain</option>
                <option value="assets/images/gold_coin.jpg">24K 999 Lakshmi Gold Coin</option>
                <option value="assets/images/silver_collection.jpg">925 Pure Silver Bridal Payal</option>
              </select>
            </div>

            <div class="form-field" style="grid-column: 1 / -1;">
              <label>Stone / Pearl Detailing</label>
              <input type="text" id="new-item-stone" placeholder="e.g. Zambian Emeralds, Basra Pearls, or Pure Solid Gold">
            </div>

            <div class="form-field" style="grid-column: 1 / -1;">
              <label>Product Description / विवरण</label>
              <textarea id="new-item-desc" rows="2" placeholder="Brief description of the design and craftsmanship..."></textarea>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" style="margin-top: 1.5rem; width: 100%; padding: 0.95rem;">
            + Publish Ornament to Online Store Now
          </button>
        </form>
      </div>

      <!-- Tab 2: Update Live Bullion Rates -->
      <div class="dealer-tab-pane" id="dealer-rates-tab">
        <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.5rem;">
          Change today's bullion market rates. As soon as you save, <strong>all product prices across the website will instantly recalculate</strong> based on net gold weight!
        </p>

        <form onsubmit="saveDealerRates(event)">
          <div class="rate-editor-grid">
            <div class="form-field">
              <label>24K Gold (₹ / 1g)</label>
              <input type="number" id="dealer-rate-24k" step="1" required>
              <small style="color: var(--text-dim);">₹7,845 = ₹78,450/10g</small>
            </div>
            <div class="form-field">
              <label>22K 916 Gold (₹ / 1g)</label>
              <input type="number" id="dealer-rate-22k" step="1" required>
              <small style="color: var(--text-dim);">₹7,195 = ₹71,950/10g</small>
            </div>
            <div class="form-field">
              <label>18K Gold (₹ / 1g)</label>
              <input type="number" id="dealer-rate-18k" step="1" required>
              <small style="color: var(--text-dim);">₹5,885 = ₹58,850/10g</small>
            </div>
            <div class="form-field">
              <label>Silver 999 (₹ / 1g)</label>
              <input type="number" id="dealer-rate-silver" step="0.1" required>
              <small style="color: var(--text-dim);">₹94.5 = ₹94,500/kg</small>
            </div>
          </div>

          <button type="submit" class="btn btn-gold" style="padding: 0.9rem 2rem;">
            💾 Save Rates & Update All Store Prices
          </button>
        </form>
      </div>

      <!-- Tab 3: Current Online Inventory -->
      <div class="dealer-tab-pane" id="dealer-inventory-tab">
        <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1rem;">
          Manage items currently displayed in the online store. You can remove or archive any piece.
        </p>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
            <thead>
              <tr style="background: var(--bg-warm); border-bottom: 1.5px solid var(--border-medium);">
                <th style="padding: 0.75rem;">Photo</th>
                <th style="padding: 0.75rem;">Name & Code</th>
                <th style="padding: 0.75rem;">Net Wt</th>
                <th style="padding: 0.75rem;">Live Price</th>
                <th style="padding: 0.75rem;">Status</th>
                <th style="padding: 0.75rem;">Action</th>
              </tr>
            </thead>
            <tbody id="dealer-inventory-tbody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       SLIDING CART / BAG DRAWER & WISHLIST DRAWER
       ======================================================================== -->
  <div class="side-drawer-overlay" id="drawer-overlay" onclick="closeDrawers()"></div>

  <!-- Shopping Bag Drawer -->
  <div class="side-drawer-panel" id="cart-drawer">
    <div class="drawer-header">
      <h3>Your Jewellery Bag (शॉपिंग बैग)</h3>
      <button onclick="closeDrawers()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
    </div>
    <div class="drawer-body" id="cart-drawer-items">
      <!-- Injected dynamically -->
    </div>
    <div class="drawer-footer">
      <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.15rem; color: var(--brand-plum); margin-bottom: 1rem;">
        <span>Estimated Bag Total:</span>
        <span id="cart-total-price">₹0</span>
      </div>
      <a href="#" id="cart-checkout-btn" class="btn btn-primary" style="width: 100%;" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/></svg>
        Order All via WhatsApp with Wellesley Ganj
      </a>
    </div>
  </div>

  <!-- Wishlist Drawer -->
  <div class="side-drawer-panel" id="wishlist-drawer">
    <div class="drawer-header">
      <h3>Saved Designs (पसंदीदा संग्रह)</h3>
      <button onclick="closeDrawers()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
    </div>
    <div class="drawer-body" id="wishlist-drawer-items">
      <!-- Injected dynamically -->
    </div>
  </div>

  <!-- Quick View Modal -->
  <div class="modal-overlay" id="quickview-modal">
    <div class="modal-card">
      <button onclick="closeModal('quickview-modal')" style="position: absolute; top: 1rem; right: 1.25rem; background: none; border: none; font-size: 1.8rem; cursor: pointer; color: var(--text-dim); z-index: 10;">&times;</button>
      <div id="quickview-body">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>

  <!-- Floating WhatsApp Concierge -->
  <a href="https://wa.me/919450000000?text=Namaste%20Rajesh%20Jewellers%20Mirzapur%2C%20I%20am%20browsing%20your%20online%20store%20and%20need%20assistance." target="_blank" class="floating-whatsapp" title="Chat with Wellesley Ganj Showroom">
    <svg viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zM17.5 14.5c-.24.7-.82 1.28-1.5 1.5-.7.22-1.6.2-2.5-.2-1.5-.6-2.9-1.6-4-2.7-1.1-1.1-2.1-2.5-2.7-4-.4-.9-.4-1.8-.2-2.5.22-.68.8-1.26 1.5-1.5.2-.08.4-.08.6 0l1.4 1.1c.2.16.3.4.26.65l-.3 1.2c-.08.3 0 .6.2.8.6.6 1.3 1.3 1.9 1.9.2.2.5.28.8.2l1.2-.3c.25-.04.49.06.65.26l1.1 1.4c.08.2.08.4 0 .6z"/></svg>
  </a>

  <!-- ========================================================================
       MOBILE LUXURY STICKY BOTTOM APP BAR (TANISHQ / BLUESTONE STYLE)
       ======================================================================== -->
  <nav class="mobile-bottom-nav" id="mobile-bottom-nav">
    <a href="#" class="mobile-nav-btn active" onclick="window.scrollTo({top:0, behavior:'smooth'})">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Home</span>
    </a>
    <a href="#catalog-section" class="mobile-nav-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span>Designs</span>
    </a>
    <a href="#calculator" class="mobile-nav-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="14"/><line x1="12" y1="14" x2="12" y2="14"/><line x1="8" y1="14" x2="8" y2="14"/><line x1="16" y1="18" x2="16" y2="18"/><line x1="12" y1="18" x2="12" y2="18"/><line x1="8" y1="18" x2="8" y2="18"/></svg>
      <span>Rate Calc</span>
    </a>
    <a href="javascript:void(0)" class="mobile-nav-btn" onclick="openWishlistDrawer()">
      <div style="position: relative; display: inline-flex;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="badge-count wishlist-count mobile-badge">0</span>
      </div>
      <span>Saved</span>
    </a>
    <a href="javascript:void(0)" class="mobile-nav-btn" onclick="openCartDrawer()">
      <div style="position: relative; display: inline-flex;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="badge-count bag-count mobile-badge">0</span>
      </div>
      <span>Bag</span>
    </a>
  </nav>

  <!-- JavaScript Engine -->
  <script src="js/app.js"></script>
</body>
</html>
