<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rajesh Jewellers Mirzapur | Online Jewellery Store & Live Bullion Rates</title>
  <meta name="description" content="Shop 22K BIS 916 hallmarked bridal jewellery, gold necklaces, antique temple bangles, certified diamond solitaires, and 925 silver at Rajesh Jewellers, Wellesley Ganj, Mirzapur.">
  <meta name="keywords" content="Rajesh Jewellers Mirzapur, Wellesley Ganj Jewellers, gold store Mirzapur, buy jewellery online Mirzapur, 916 hallmark gold, gold rate today Mirzapur, wedding jewellery Mirzapur">
  <meta name="theme-color" content="#581420">

  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="Rajesh Jewellers Mirzapur | Online Jewellery Showcase">
  <meta property="og:description" content="Explore pure 22K BIS 916 Hallmarked Gold, Bridal Polki, and Certified Diamonds in Wellesley Ganj, Mirzapur.">
  <meta property="og:image" content="assets/images/hero_bridal.jpg">
  <meta property="og:type" content="website">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='48' fill='%23581420' stroke='%23B88E2F' stroke-width='4'/><text x='50%' y='60%' font-family='serif' font-weight='bold' font-size='38' fill='%23FFFFFF' text-anchor='middle'>RJ</text></svg>">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <!-- ========================================================================
       TOP ANNOUNCEMENT & LIVE BULLION BAR
       ======================================================================== -->
  <header class="top-bar">
    <div class="container">
      <div class="top-bar-flex">
        <div class="top-rate-marquee">
          <div class="rate-chip">
            <span class="live-pulse-dot"></span>
            <span style="font-weight: 600; color: #DFBE6B;">LIVE RATES:</span>
          </div>
          <div class="rate-chip">
            <span>24K Gold:</span>
            <strong id="rate-24k" style="color: #FFF;">₹78,450</strong>
          </div>
          <span style="opacity: 0.3;">|</span>
          <div class="rate-chip">
            <span>22K 916 Hallmark:</span>
            <strong id="rate-22k" style="color: #DFBE6B;">₹71,950</strong>
          </div>
          <span style="opacity: 0.3;">|</span>
          <div class="rate-chip">
            <span>18K Diamond:</span>
            <strong id="rate-18k" style="color: #FFF;">₹58,850</strong>
          </div>
          <span style="opacity: 0.3;">|</span>
          <div class="rate-chip">
            <span>Silver 999:</span>
            <strong id="rate-silver" style="color: #FFF;">₹94,500/kg</strong>
          </div>
          <span style="opacity: 0.3;">|</span>
          <div class="rate-chip">
            <span style="font-size: 0.72rem; color: #DFBE6B;" id="rate-timestamp">Mirzapur Market</span>
            <button class="rate-refresh-btn" onclick="refreshLiveRates()" title="Refresh Live Market Rates">⟳ Refresh</button>
          </div>
        </div>

        <div class="top-store-info">
          <a href="#showroom" class="top-info-link">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            Station Rd, Wellesley Ganj, Mirzapur
          </a>
          <a href="tel:05442220000" class="top-info-link">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            05442-220000
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- ========================================================================
       MAIN SITE HEADER & SEARCH (TANISHQ / BLUESTONE STYLE)
       ======================================================================== -->
  <header class="site-header" id="navbar">
    <div class="container">
      <div class="header-main-row">
        <!-- Brand Logo -->
        <a href="#" class="brand-wrap">
          <div class="brand-emblem">
            <svg viewBox="0 0 24 24">
              <path d="M12 2L1 21h22L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 11h2v4h-2zm0 5h2v2h-2z"/>
            </svg>
          </div>
          <div class="brand-title-box">
            <span class="brand-name">RAJESH JEWELLERS</span>
            <span class="brand-sub">WELLESLEY GANJ • MIRZAPUR</span>
          </div>
        </a>

        <!-- Live Instant Search Bar (BlueStone style) -->
        <div class="header-search-wrap">
          <div class="search-input-box">
            <input type="text" id="search-input" placeholder="Search 22K Gold Chokers, Temple Kadas, Solitaire Rings, Payal..." autocomplete="off">
            <button type="button" aria-label="Search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </button>
          </div>
          <!-- Dropdown Matches Container -->
          <div class="search-dropdown" id="search-dropdown"></div>
        </div>

        <!-- Header Actions: Wishlist, Cart, VIP Visit -->
        <div class="header-actions">
          <!-- Wishlist Button -->
          <button class="header-icon-btn" onclick="openWishlistDrawer()" title="Saved Designs">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span class="badge-count wishlist-count">0</span>
          </button>

          <!-- Shopping Bag Button -->
          <button class="header-icon-btn" onclick="openCartDrawer()" title="Shopping Bag">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span class="badge-count bag-count">0</span>
          </button>

          <!-- Book Appointment Button -->
          <button class="btn btn-primary" onclick="bookShowroomVisit()">
            Book VIP Visit
          </button>
        </div>
      </div>
    </div>

    <!-- Secondary Category Navigation Bar -->
    <div class="header-nav-bar">
      <div class="container">
        <ul class="nav-links-row">
          <li class="nav-link-item active"><a href="#catalog-section" onclick="filterCategory('all')">All Jewellery</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('bridal')">Royal Bridal</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('gold')">Gold Necklaces</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('bangles')">Temple Kadas & Bangles</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('diamond')">Solitaire Diamonds</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('everyday')">Jhumkas & Mangalsutra</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('mens')">Men's Jewels</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('coins')">24K Coins</a></li>
          <li class="nav-link-item"><a href="#catalog-section" onclick="filterCategory('silver')">925 Silver</a></li>
          <li class="nav-link-item"><a href="#calculator" style="color: var(--gold-dark);">★ Price Calculator</a></li>
          <li class="nav-link-item"><a href="#scheme">11+1 Gold Scheme</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- ========================================================================
       BRIGHT HERO BANNER & 3D PARTICLE SHOWCASE
       ======================================================================== -->
  <section class="hero-banner-section">
    <!-- Interactive 3D Gold Dust Particle Canvas -->
    <canvas id="gold-particles-canvas"></canvas>

    <div class="container">
      <div class="hero-banner-grid">
        <div class="hero-banner-copy">
          <span class="kicker-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            Lagan Mahotsav Special • Wellesley Ganj, Mirzapur
          </span>

          <h1 class="hero-heading">
            Royal Heirloom Jewellery, <br>
            <span class="gold-gradient-text">100% BIS 916 Hallmarked.</span>
          </h1>

          <p class="hero-desc">
            Explore Mirzapur's most prestigious online jewellery showcase. Handcrafted bridal polki, 22K temple kadas, certified solitaires, and pure silver articles with zero compromise on purity and transparent computerized pricing.
          </p>

          <div class="hero-cta-group">
            <a href="#catalog-section" class="btn btn-primary" onclick="filterCategory('bridal')">
              Explore Bridal Catalog
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </a>
            <a href="#calculator" class="btn btn-outline-gold">
              Calculate Gold Price
            </a>
            <button class="btn btn-outline" onclick="bookShowroomVisit()">
              Book VIP Visit
            </button>
          </div>

          <div class="hero-trust-badges">
            <div class="trust-badge-item">
              <div class="trust-badge-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
              </div>
              <div class="trust-badge-text">
                <strong>100% BIS 916</strong>
                <span>6-Digit HUID Laser</span>
              </div>
            </div>

            <div class="trust-badge-item">
              <div class="trust-badge-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
              </div>
              <div class="trust-badge-text">
                <strong>Karatmeter Tested</strong>
                <span>Instant In-Store Check</span>
              </div>
            </div>

            <div class="trust-badge-item">
              <div class="trust-badge-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </div>
              <div class="trust-badge-text">
                <strong>5.0 ★ Google Trust</strong>
                <span>Wellesley Ganj, Mirzapur</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-visual-frame">
          <img src="assets/images/hero_bridal.jpg" alt="Rajesh Jewellers Royal Bridal Lagan Collection">
          <div class="floating-hero-pill">
            <span style="font-size: 1.5rem;">👑</span>
            <div>
              <strong style="color: var(--brand-plum); font-size: 0.88rem; display: block;">Shahi Rajwada Bridal Set</strong>
              <span style="color: var(--text-dim); font-size: 0.75rem;">22K Hallmarked • Uncut Polki & Emeralds</span>
            </div>
            <button class="btn btn-primary" style="padding: 0.4rem 0.85rem; font-size: 0.75rem; margin-left: 0.5rem;" onclick="openQuickView('RJ-BR-101')">
              View Specs
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       CIRCULAR STORY-STYLE CATEGORY CAROUSEL (TANISHQ / BLUESTONE BUBBLES)
       ======================================================================== -->
  <section class="category-bubbles-section" id="categories-section">
    <div class="container">
      <div class="category-section-header">
        <span class="kicker-tag">Curated Collections</span>
        <h2>Shop by Category (श्रेणी अनुसार आभूषण)</h2>
        <p>Explore pure 22K BIS 916 hallmarked bridal sets, temple kadas, certified solitaires, and 24K gold coins.</p>
      </div>

      <div class="bubbles-scroll-track">
        <div class="cat-bubble-item active" data-filter="all">
          <div class="cat-bubble-avatar">
            <img src="assets/images/necklace_collection.jpg" alt="All Collections">
          </div>
          <span class="cat-bubble-title">All Designs</span>
        </div>

        <div class="cat-bubble-item" data-filter="bridal">
          <div class="cat-bubble-avatar">
            <img src="assets/images/hero_bridal.jpg" alt="Royal Bridal">
          </div>
          <span class="cat-bubble-title">Bridal Sets</span>
        </div>

        <div class="cat-bubble-item" data-filter="gold">
          <div class="cat-bubble-avatar">
            <img src="assets/images/necklace_collection.jpg" alt="22K Gold Chokers">
          </div>
          <span class="cat-bubble-title">22K Necklaces</span>
        </div>

        <div class="cat-bubble-item" data-filter="bangles">
          <div class="cat-bubble-avatar">
            <img src="assets/images/antique_bangles.jpg" alt="Temple Bangles">
          </div>
          <span class="cat-bubble-title">Temple Kadas</span>
        </div>

        <div class="cat-bubble-item" data-filter="diamond">
          <div class="cat-bubble-avatar">
            <img src="assets/images/diamond_rings.jpg" alt="Solitaire Diamonds">
          </div>
          <span class="cat-bubble-title">Diamonds</span>
        </div>

        <div class="cat-bubble-item" data-filter="everyday">
          <div class="cat-bubble-avatar">
            <img src="assets/images/earrings_jhumka.jpg" alt="Chandbali Jhumkas">
          </div>
          <span class="cat-bubble-title">Jhumkas</span>
        </div>

        <div class="cat-bubble-item" data-filter="mens">
          <div class="cat-bubble-avatar">
            <img src="assets/images/mens_chain_kada.jpg" alt="Men's Jewels">
          </div>
          <span class="cat-bubble-title">Men's Kada</span>
        </div>

        <div class="cat-bubble-item" data-filter="coins">
          <div class="cat-bubble-avatar">
            <img src="assets/images/gold_coin.jpg" alt="24K Gold Coins">
          </div>
          <span class="cat-bubble-title">24K Coins</span>
        </div>

        <div class="cat-bubble-item" data-filter="silver">
          <div class="cat-bubble-avatar">
            <img src="assets/images/silver_collection.jpg" alt="925 Silver">
          </div>
          <span class="cat-bubble-title">925 Silver</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       ONLINE STORE CATALOGUE & PLP GRID (TANISHQ / BLUESTONE STYLE)
       ======================================================================== -->
  <section class="catalog-section" id="catalog-section">
    <div class="container">
      <div class="catalog-header-flex">
        <div class="catalog-header-left">
          <span class="kicker-tag" style="background: var(--gold-soft); color: var(--gold-dark); border-color: var(--gold-border);">
            Online Store Catalog
          </span>
          <h2>राजेश ज्वेलर्स ऑनलाइन आभूषण संग्रह</h2>
          <p id="items-count-display">Showing 8 Designs in Wellesley Ganj</p>
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-warm); padding: 0.45rem 1rem; border-radius: 999px; border: 1px solid var(--border-medium); font-size: 0.8rem; color: var(--brand-plum); font-weight: 600;">
          <span class="live-pulse-dot" style="width: 6px; height: 6px;"></span>
          100% Certified 22K 916 Hallmark Designs
        </div>
      </div>

      <!-- Controls & Sorting Bar -->
      <div class="catalog-controls-bar">
        <div class="category-filter-chips">
          <button class="filter-chip active" data-filter="all">All Jewellery</button>
          <button class="filter-chip" data-filter="bridal">Royal Bridal</button>
          <button class="filter-chip" data-filter="gold">22K Gold Necklaces</button>
          <button class="filter-chip" data-filter="bangles">Temple Bangles</button>
          <button class="filter-chip" data-filter="diamond">Solitaire Diamonds</button>
          <button class="filter-chip" data-filter="everyday">Jhumkas</button>
          <button class="filter-chip" data-filter="mens">Men's Kada</button>
          <button class="filter-chip" data-filter="coins">24K Coins</button>
          <button class="filter-chip" data-filter="silver">925 Silver</button>
        </div>

        <div class="sort-select-box">
          <label for="catalog-sort-select">Sort By:</label>
          <select id="catalog-sort-select" class="sort-dropdown-select">
            <option value="featured">Featured / लोकप्रिय</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="weight">Weight: Light to Heavy</option>
          </select>
        </div>
      </div>

      <!-- Product Cards Grid -->
      <div class="ecommerce-grid" id="products-grid">
        <!-- Injected dynamically via app.js -->
      </div>
    </div>
  </section>

  <!-- ========================================================================
       TRANSPARENT GOLD PRICE CALCULATOR (BRIGHT LUXURY CARD)
       ======================================================================== -->
  <section class="calc-section" id="calculator">
    <div class="container">
      <div style="text-align: center; max-width: 650px; margin: 0 auto 3rem;">
        <span class="kicker-tag">100% Honest & Transparent Pricing</span>
        <h2 style="font-size: 2.2rem; margin-bottom: 0.5rem;">पारदर्शी गोल्ड मूल्य कैलकुलेटर</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          Know your exact gold and making price before visiting. Real-time Wellesley Ganj bullion rates + lowest making charges with 3% GST breakdown.
        </p>
      </div>

      <div class="calc-bright-box">
        <div class="calc-grid-inner">
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <!-- Metal Selection -->
            <div class="form-field">
              <label>Select Metal Purity / शुद्धता</label>
              <div class="metal-purity-buttons">
                <button type="button" class="metal-choice-btn active" data-metal="gold22k">
                  <strong>22K Gold</strong>
                  <span>916 Hallmark</span>
                </button>
                <button type="button" class="metal-choice-btn" data-metal="gold24k">
                  <strong>24K Gold</strong>
                  <span>999 Bullion</span>
                </button>
                <button type="button" class="metal-choice-btn" data-metal="gold18k">
                  <strong>18K Gold</strong>
                  <span>Diamond Setting</span>
                </button>
              </div>
            </div>

            <!-- Weight Input & Chips -->
            <div class="form-field">
              <label for="calc-weight">Gold Weight in Grams / वजन (ग्राम)</label>
              <input type="number" id="calc-weight" value="10" min="0.5" step="0.1" style="font-size: 1.15rem; font-weight: 700; color: var(--brand-plum);">
              <div class="preset-chips-row">
                <button type="button" class="chip-btn" data-weight="2">2g</button>
                <button type="button" class="chip-btn" data-weight="5">5g</button>
                <button type="button" class="chip-btn" data-weight="8">8g (1 Tola)</button>
                <button type="button" class="chip-btn active" data-weight="10">10g</button>
                <button type="button" class="chip-btn" data-weight="20">20g</button>
                <button type="button" class="chip-btn" data-weight="50">50g</button>
                <button type="button" class="chip-btn" data-weight="100">100g</button>
              </div>
            </div>

            <!-- Making Charge Slider -->
            <div class="form-field">
              <div style="display: flex; justify-content: space-between; align-items: baseline;">
                <label>Making Charges (गड़ाई शुल्क)</label>
                <strong id="calc-making-val" style="color: var(--brand-plum); font-size: 1.1rem;">10%</strong>
              </div>
              <input type="range" id="calc-making" min="7" max="15" value="10" step="0.5" style="accent-color: var(--brand-plum); cursor: pointer;">
              <div style="display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--text-dim); margin-top: 0.25rem;">
                <span>Chains (7-8%)</span>
                <span>Standard (10%)</span>
                <span>Bridal Polki/Temple (12-14%)</span>
              </div>
            </div>
          </div>

          <!-- Output Bill Card -->
          <div class="calc-bill-card">
            <div style="border-bottom: 1px solid var(--border-medium); padding-bottom: 1rem; margin-bottom: 1.25rem;">
              <h4 style="font-size: 0.95rem; color: var(--brand-plum); text-transform: uppercase;">Computerized Estimated Quotation</h4>
              <p style="font-size: 0.8rem; color: var(--text-dim);" id="res-metal-name">22K 916 Hallmark (10g @ ₹7,195/g)</p>
            </div>

            <div class="bill-line-item">
              <span>Pure Metal Value:</span>
              <strong id="res-gold-val" style="color: var(--text-main);">₹71,950</strong>
            </div>
            <div class="bill-line-item">
              <span>Making Charges:</span>
              <strong id="res-making-val" style="color: var(--text-main);">₹7,195 (10%)</strong>
            </div>
            <div class="bill-line-item">
              <span>GST (3% Indian Tax):</span>
              <strong id="res-gst-val" style="color: var(--text-main);">₹2,374 (3%)</strong>
            </div>

            <div class="bill-line-item grand-total-row">
              <span>Total Estimated Price:</span>
              <div class="grand-total-price" id="res-total-val">₹81,519</div>
            </div>

            <p style="font-size: 0.72rem; color: var(--text-dim); margin-top: 1rem; line-height: 1.4;">
              * Note: Exact final price depends on net gold weight after stone deduction on our certified computerized Karatmeter in Wellesley Ganj.
            </p>

            <a href="#" class="btn btn-primary" id="calc-whatsapp-btn" style="width: 100%; margin-top: 1.25rem;" target="_blank">
